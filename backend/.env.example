# =========================================================
# AI 智能面试系统配置模板
# 复制本文件为 backend/.env 后再填写。
# 除特别说明外，等号右侧留空时，程序使用每条注释中的代码默认值，不会用空字符串覆盖默认值。
# 请按各项注释填写密钥；未配置的功能将不可用。
# =========================================================

# -------------------- 基础运行 --------------------
# DEBUG_MODE: true/false。留空默认 false
DEBUG_MODE=
# CORS_ORIGINS: 允许的前端来源，多个用英文逗号分隔。留空默认 http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=

# -------------------- 数据库（必填密码） --------------------
# MYSQL_HOST: 留空默认 localhost
MYSQL_HOST=
# MYSQL_PORT: 留空默认 3306
MYSQL_PORT=
# MYSQL_USER: 留空默认 root
MYSQL_USER=
# 请配置 MYSQL_PASSWORD，获取方式：MySQL 安装时为本账户设置的密码，或云数据库控制台的账号页面
MYSQL_PASSWORD=
# MYSQL_DB: 留空默认 test_db。请先在 MySQL 中创建同名库，程序只建表、不建库
MYSQL_DB=
# MYSQL_POOL_SIZE: 留空默认 20
MYSQL_POOL_SIZE=
# MYSQL_MAX_OVERFLOW: 留空默认 30
MYSQL_MAX_OVERFLOW=
# MYSQL_POOL_RECYCLE: 秒。留空默认 3600
MYSQL_POOL_RECYCLE=
# MYSQL_POOL_TIMEOUT: 秒。留空默认 30
MYSQL_POOL_TIMEOUT=

# -------------------- Redis（可选，连不上时服务仍能启动） --------------------
# REDIS_HOST: 留空默认 localhost
REDIS_HOST=
# REDIS_PORT: 留空默认 6379
REDIS_PORT=
# REDIS_DB: 留空默认 0
REDIS_DB=
# 请配置 REDIS_PASSWORD，获取方式：Redis 的 requirepass，或云厂商控制台；本地无密码请留空
REDIS_PASSWORD=

# -------------------- DeepSeek（面试、报告、简历、知识抽取、视频画面） --------------------
# 请配置 DEEPSEEK_API_KEY，获取方式：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL: 留空默认 https://api.deepseek.com
DEEPSEEK_BASE_URL=
# DEEPSEEK_MODEL: 留空默认 deepseek-flash。视频画面分析需要支持看图的模型
DEEPSEEK_MODEL=
# DEEPSEEK_THINKING: disabled 或 enabled。留空默认 disabled
DEEPSEEK_THINKING=
# DEEPSEEK_TIMEOUT: 秒。留空默认 120
DEEPSEEK_TIMEOUT=
# 下列模型留空时都使用 DEEPSEEK_MODEL
DEEPSEEK_MODEL_INTERVIEW=
DEEPSEEK_MODEL_REPORT=
DEEPSEEK_MODEL_RESUME=
DEEPSEEK_MODEL_RESUME_OPTIMIZE=
DEEPSEEK_MODEL_KNOWLEDGE=
DEEPSEEK_MODEL_VISION=
# DEEPSEEK_VISION_TIMEOUT: 秒。留空默认 60
DEEPSEEK_VISION_TIMEOUT=

# -------------------- 语音转写（本地 Whisper，不是 DeepSeek） --------------------
# WHISPER_MODEL_NAME: tiny/base/small/medium/large。留空默认 small
WHISPER_MODEL_NAME=
# ASR_LANGUAGE: 留空默认 zh
ASR_LANGUAGE=

# -------------------- RAG --------------------
# RAG_LOCAL_EMBEDDING_MODEL_PATH: 留空默认 ./models_rag/bge-small-zh-v1.5（相对 backend/app）
RAG_LOCAL_EMBEDDING_MODEL_PATH=
# RAG_EMBEDDING_DIMENSION: bge-small-zh-v1.5 为 512。留空默认 512
RAG_EMBEDDING_DIMENSION=
# CHROMA_DB_PATH: rag_plan1 那套集合的路径。留空默认 ./chroma_db。
# 子块集合固定写在 ./chroma_db，不读这个变量。
CHROMA_DB_PATH=
# CHROMA_CHILD_COLLECTION_NAME: 留空默认 kb_child_chunks
CHROMA_CHILD_COLLECTION_NAME=
# RAG_COLLECTION_NAME: 留空默认 interview_rag
RAG_COLLECTION_NAME=
# RAG_EMBED_MODEL_NAME: 只写入分块元数据。留空默认 text-embedding-3-small
RAG_EMBED_MODEL_NAME=
# RAG_TOP_K: 留空默认 5
RAG_TOP_K=
# RAG_RERANK_TOP_N: 留空默认 3
RAG_RERANK_TOP_N=
# RAG_RETRIEVE_CACHE_TTL: 秒。留空默认 60
RAG_RETRIEVE_CACHE_TTL=
# RAG_RERANK_MODEL: 留空默认 BAAI/bge-reranker-base，首次使用会从 Hugging Face 下载
RAG_RERANK_MODEL=
# RAG_USE_DASHSCOPE_EMBEDDING: 读到 true 也只打警告并忽略。留空即可
RAG_USE_DASHSCOPE_EMBEDDING=

# -------------------- 面试上下文与成长建议 --------------------
# INTERVIEW_CONTEXT_MAX_CHARS: 留空默认 5200
INTERVIEW_CONTEXT_MAX_CHARS=
# INTERVIEW_CONTEXT_MAX_PAIRS: 留空默认 8
INTERVIEW_CONTEXT_MAX_PAIRS=
# GROWTH_ADVICE_MAX_SAMPLES: 留空默认 24
GROWTH_ADVICE_MAX_SAMPLES=
# GROWTH_ADVICE_LLM_TIMEOUT: 秒。留空默认 45
GROWTH_ADVICE_LLM_TIMEOUT=
# GROWTH_ADVICE_LLM_RETRY_TIMEOUT: 秒。留空默认 25
GROWTH_ADVICE_LLM_RETRY_TIMEOUT=

# -------------------- PDF --------------------
# PDF_CN_FONT: 中文字体文件绝对路径。留空时依次尝试系统字体
PDF_CN_FONT=

# -------------------- 讯飞虚拟人（可选） --------------------
# 请配置 IFLYTEK_APP_ID，获取方式：https://console.xfyun.cn/app/myapp
IFLYTEK_APP_ID=
# 请配置 IFLYTEK_API_KEY，获取方式：https://console.xfyun.cn/app/myapp
IFLYTEK_API_KEY=
# 请配置 IFLYTEK_API_SECRET，获取方式：https://console.xfyun.cn/app/myapp
IFLYTEK_API_SECRET=
# IFLYTEK_VH_SCENE_ID: 控制台「接口服务ID」。
# 本行留空会保持为空，不会自动变成占位值 2。只有环境中完全没有这一项时，代码才使用 2。
IFLYTEK_VH_SCENE_ID=
# IFLYTEK_VH_REQUEST_UID: 讯飞用户服务 uid。没有就留空，不要填业务库用户 ID
IFLYTEK_VH_REQUEST_UID=
# IFLYTEK_VH_INTERACT_SERVER_URL: 留空默认 wss://avatar.cn-huadong-1.xf-yun.com/v1/interact
IFLYTEK_VH_INTERACT_SERVER_URL=
# IFLYTEK_VH_HOST: 留空默认 vms.cn-huadong-1.xf-yun.com
IFLYTEK_VH_HOST=
# IFLYTEK_VH_AVATAR_ID: 留空默认 111204007。请改成控制台已授权的形象 ID
IFLYTEK_VH_AVATAR_ID=
# IFLYTEK_VH_WIDTH: 留空默认 720
IFLYTEK_VH_WIDTH=
# IFLYTEK_VH_HEIGHT: 留空默认 1280
IFLYTEK_VH_HEIGHT=
# IFLYTEK_VH_STREAM_PROTOCOL: 留空默认 rtmp。浏览器 WebSDK 常用 xrtc
IFLYTEK_VH_STREAM_PROTOCOL=
# IFLYTEK_VH_TTS_VCN: 留空默认 x4_yezi
IFLYTEK_VH_TTS_VCN=
# IFLYTEK_VH_SYNC_MODE: 1 表示音频驱动口型。留空默认 1
IFLYTEK_VH_SYNC_MODE=
# IFLYTEK_VH_HAS_AUDIO: true/false。留空默认 true
IFLYTEK_VH_HAS_AUDIO=
# IFLYTEK_VH_VIDEO_TYPE: 留空默认 lip_sync
IFLYTEK_VH_VIDEO_TYPE=
# IFLYTEK_VH_TTS_AUE: 留空默认 lame
IFLYTEK_VH_TTS_AUE=
# IFLYTEK_VH_TTS_AUDIO_ENCODING: 留空默认 mp3
IFLYTEK_VH_TTS_AUDIO_ENCODING=
# IFLYTEK_VH_BG_RES_KEY: 数字人背景资源键，没有就留空
IFLYTEK_VH_BG_RES_KEY=
