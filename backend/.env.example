# =========================================================
# AI 智能面试系统配置模板（无敏感信息）
# 说明：
# - 本文件仅做模板，请复制为 .env 后填写真实值
# - 所有值均为示例，生产环境需按实际资源调整
# =========================================================

# -------------------- 基础运行 --------------------
# DEBUG_MODE: true/false，是否开启调试日志
DEBUG_MODE=false
# CORS_ORIGINS: 允许跨域来源，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -------------------- 数据库（必填） --------------------
# MYSQL_HOST: 数据库地址，通常 localhost 或内网地址
MYSQL_HOST=localhost
# MYSQL_PORT: 取值范围 1-65535，默认 3306
MYSQL_PORT=3306
# MYSQL_USER: 数据库用户名
MYSQL_USER=root
# MYSQL_PASSWORD: 数据库密码（请填写真实值）
MYSQL_PASSWORD=
# MYSQL_DB: 业务数据库名
MYSQL_DB=ai_interview

# 连接池参数（可选）
# MYSQL_POOL_SIZE: 常用 5-50
MYSQL_POOL_SIZE=10
# MYSQL_MAX_OVERFLOW: 常用 10-100
MYSQL_MAX_OVERFLOW=20
# MYSQL_POOL_RECYCLE: 秒，常用 1800-7200
MYSQL_POOL_RECYCLE=3600
# MYSQL_POOL_TIMEOUT: 秒，常用 10-60
MYSQL_POOL_TIMEOUT=30

# -------------------- Redis（可选） --------------------
# 未配置时系统可降级运行（缓存能力受限）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# -------------------- DeepSeek --------------------
# DEEPSEEK_API_KEY: DeepSeek API Key（必填，https://platform.deepseek.com/）
DEEPSEEK_API_KEY=replace_with_deepseek_api_key
# OpenAI 兼容地址，不要带 /v1 结尾也可，SDK 会请求 /chat/completions
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 当前视觉+文本模型。deepseek-v4-pro 不支持看图，视频分析请保持 flash
DEEPSEEK_MODEL=deepseek-flash
# 思考模式默认关闭。需要更高质量报告时可改为 enabled，面试追问会变慢
DEEPSEEK_THINKING=disabled
# DEEPSEEK_TIMEOUT: 秒
DEEPSEEK_TIMEOUT=120
# 可按场景覆盖，不填则都用 DEEPSEEK_MODEL
# DEEPSEEK_MODEL_INTERVIEW=deepseek-flash
# DEEPSEEK_MODEL_REPORT=deepseek-flash
# DEEPSEEK_MODEL_RESUME=deepseek-flash
# DEEPSEEK_MODEL_KNOWLEDGE=deepseek-flash
# DEEPSEEK_MODEL_VISION=deepseek-flash

# -------------------- RAG 向量与检索 --------------------
# DeepSeek 没有 Embedding 接口。知识库固定使用本地 bge-small-zh-v1.5（512 维）。
# 若以前用过云端 1024 维向量，需要重新上传知识库。
CHROMA_CHILD_COLLECTION_NAME=kb_child_chunks
RAG_EMBEDDING_DIMENSION=512
RAG_LOCAL_EMBEDDING_MODEL_PATH=./models_rag/bge-small-zh-v1.5
# CHROMA_DB_PATH: 向量库本地路径
CHROMA_DB_PATH=./chroma_db
RAG_COLLECTION_NAME=interview_rag
RAG_TOP_K=5
RAG_RERANK_TOP_N=3
# RAG_RETRIEVE_CACHE_TTL: 秒，常用 30-300
RAG_RETRIEVE_CACHE_TTL=60
RAG_RERANK_MODEL=BAAI/bge-reranker-base

# -------------------- 多模态（语音/视频） --------------------
# 语音转写仍用本地 Whisper，不是 DeepSeek
WHISPER_MODEL_NAME=small
# ASR_LANGUAGE: zh/en
ASR_LANGUAGE=zh

# -------------------- 成长建议模块 --------------------
GROWTH_ADVICE_MAX_SAMPLES=24
GROWTH_ADVICE_LLM_TIMEOUT=45
GROWTH_ADVICE_LLM_RETRY_TIMEOUT=25

# -------------------- 讯飞数字人 --------------------
# 以下参数为空时，数字人能力不可用
IFLYTEK_APP_ID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=
# 交互 WebSDK 的 sceneId = 控制台「服务编排」页的「接口服务ID」（长数字）；不要用 2 等占位
IFLYTEK_VH_SCENE_ID=
# vms2d HTTP 请求头 uid：无讯飞用户服务 uid 时请留空（不要填业务库 user_id，否则易 11203）
IFLYTEK_VH_REQUEST_UID=
IFLYTEK_VH_INTERACT_SERVER_URL=wss://avatar.cn-huadong-1.xf-yun.com/v1/interact
IFLYTEK_VH_HOST=vms.cn-huadong-1.xf-yun.com
IFLYTEK_VH_AVATAR_ID=118801001
IFLYTEK_VH_WIDTH=720
IFLYTEK_VH_HEIGHT=1280
IFLYTEK_VH_STREAM_PROTOCOL=xrtc
IFLYTEK_VH_TTS_VCN=x3_qianxue

# 唇形同步关键参数（建议保持）
# IFLYTEK_VH_SYNC_MODE: 1=音频驱动口型
IFLYTEK_VH_SYNC_MODE=1
# IFLYTEK_VH_HAS_AUDIO: true/false
IFLYTEK_VH_HAS_AUDIO=true
# IFLYTEK_VH_VIDEO_TYPE: lip_sync / default
IFLYTEK_VH_VIDEO_TYPE=lip_sync
# IFLYTEK_VH_TTS_AUE: lame/pcm 等，需与 audio_encoding 对齐
IFLYTEK_VH_TTS_AUE=lame
# IFLYTEK_VH_TTS_AUDIO_ENCODING: mp3/pcm
IFLYTEK_VH_TTS_AUDIO_ENCODING=mp3
# IFLYTEK_VH_BG_RES_KEY: 数字人背景资源键（由平台下发）
IFLYTEK_VH_BG_RES_KEY=
